generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cuidadores {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_id              String                   @unique @db.Uuid
  descripcion_perfil    String
  tarifa_noche          Int
  radio_servicio_m      Int                      @default(1000)
  ubicacion_geog        Unsupported("geography")
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                 @default(now()) @db.Timestamptz(6)
  acepta_tamano_pequeno Boolean                  @default(true)
  acepta_tamano_mediano Boolean                  @default(true)
  acepta_tamano_grande  Boolean                  @default(false)
  acepta_cachorros      Boolean                  @default(false)
  tipo_vivienda         String                   @default("departamento")
  tiene_patio           Boolean                  @default(false)
  tiene_perros_propios  Boolean                  @default(false)
  tiene_gatos_propios   Boolean                  @default(false)
  rating                Decimal                  @default(0.00) @db.Decimal(3, 2)
  total_reviews         Int                      @default(0)
  usuarios              usuarios                 @relation(fields: [clerk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_id   String      @unique
  email      String      @unique
  nombre     String
  foto_url   String?
  telefono   String?
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  cuidadores cuidadores?
}
